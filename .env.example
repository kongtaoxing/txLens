# Server-only settings. Never use NEXT_PUBLIC_ for credentials.
# Current Orbio gateway for sk-orbio keys; model IDs match its public catalogue.
AI_BASE_URL=https://api.orbio.so/api/v1
AI_API_KEY=
AI_MODEL=deepseek/deepseek-v4.1-flash
AI_PROVIDER_LABEL=Orbio


# Comma-separated unpacked extension IDs permitted by the local dev server.
TXLENS_EXTENSION_IDS=

# Optional public backend origin baked into extension builds.
# Vercel defaults to its production domain; local builds default to localhost.
TXLENS_SERVICE_URL=
